# Copy this file to .env and fill in your values

# ── Required ──────────────────────────────────────────────────────────────────
GITHUB_PAT=your_github_personal_access_token_here
GEMINI_API_KEY=your_gemini_api_key_here
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/codespotlight?retryWrites=true&w=majority

# REQUIRED in production: must be set or the server will refuse to start.
# Use a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=change-this-to-a-long-random-secret-string-in-production

# ── Optional ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Your deployed frontend URL — REQUIRED in production (NODE_ENV=production).
# Renamed from ALLOWED_ORIGIN (docs and code now consistent).
CLIENT_URL=http://localhost:52870

# Secret key for the /admin/reanalyze-all endpoint.
# Set this to a strong random string to enable admin operations.
# Endpoint is disabled entirely if this is not set.
ADMIN_SECRET=change-this-to-a-strong-secret-for-admin-ops
